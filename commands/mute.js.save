const { parseDuration } = require("../utils/time");

module.exports = (bot, pool, canModerate, isOwner) => {

    // =====================================
    // PREMIUM MUTE COMMAND
    // =====================================

    bot.command("mute", async (ctx) => {

        try {

            // Check admin permission
            if (!(await canModerate(ctx))) {
                return ctx.reply("⛔ You must be a Telegram admin.");
            }

            // Must reply to someone's message
            if (!ctx.message.reply_to_message) {
                return ctx.reply(
                    "❗ Reply to a user's message.\n\nExample:\n/mute 30m Spamming links"
                );
            }

            const target = ctx.message.reply_to_message.from;

            // Can't mute yourself
            if (target.id === ctx.from.id) {
                return ctx.reply("😂 You can't mute yourself.");
            }

            // Can't mute owner
            if (target.id === Number(process.env.OWNER_ID)) {
                return ctx.reply("👑 I can't mute the owner.");
            }

            // Check if target is admin
            const targetMember = await ctx.telegram.getChatMember(
                ctx.chat.id,
                target.id
            );

            if (
                targetMember.status === "administrator" ||
                targetMember.status === "creator"
            ) {
                return ctx.reply("🛡️ I can't mute another admin.");
            }

            // --------------------------
            // Parse arguments
            // --------------------------

            const args = ctx.message.text.trim().split(/\s+/);

            let expiresAt = null;
            let durationText = "Permanent";
            let reason = "Not specified";

            if (args.length > 1) {

                const parsed = parseDuration(args[1]);

                if (parsed) {

                    expiresAt = parsed;
                    durationText = args[1];

                    if (args.length > 2) {
                        reason = args.slice(2).join(" ");
                    }

                } else {

                    reason = args.slice(1).join(" ");

                }

            }

            // --------------------------
            // Check duplicate mute
            // --------------------------

            const existing = await pool.query(
                `SELECT * FROM mutes
                 WHERE user_id=$1
                 AND chat_id=$2
                 LIMIT 1`,
                [
                    target.id,
                    ctx.chat.id
                ]
            );

            if (existing.rows.length > 0) {
                return ctx.reply("⚠️ That user is already muted.");
            }
            // --------------------------
            // Restrict member
            // --------------------------

            await ctx.telegram.restrictChatMember(
                ctx.chat.id,
                target.id,
                {
                    permissions: {
                        can_send_messages: false,
                        can_send_audios: false,
                        can_send_documents: false,
                        can_send_photos: false,
                        can_send_videos: false,
                        can_send_video_notes: false,
                        can_send_voice_notes: false,
                        can_send_polls: false,
                        can_send_other_messages: false,
                        can_add_web_page_previews: false
                    },
                    until_date: expiresAt
                        ? Math.floor(expiresAt.getTime() / 1000)
                        : undefined
                }
            );

            // --------------------------
            // Save mute
            // --------------------------

            await pool.query(
                `INSERT INTO mutes
                (user_id,chat_id,reason,muted_by,expires_at)
                VALUES($1,$2,$3,$4,$5)`,
                [
                    target.id,
                    ctx.chat.id,
                    reason,
                    ctx.from.id,
                    expiresAt
                ]
            );

            // --------------------------
            // Log action
            // --------------------------

            await pool.query(
                `INSERT INTO logs
                (chat_id,user_id,admin_id,action)
                VALUES($1,$2,$3,$4)`,
                [
                    ctx.chat.id,
                    target.id,
                    ctx.from.id,
                    "MUTE"
                ]
            );

            // --------------------------
            // Success message
            // --------------------------

            await ctx.reply(
`🔇 *User Muted Successfully*

👤 User: ${target.first_name}
🆔 ID: \`${target.id}\`
👮 Moderator: ${ctx.from.first_name}
⏳ Duration: ${durationText}
📝 Reason: ${reason}
📅 ${expiresAt ? `Expires: ${expiresAt.toUTCString()}` : "Permanent mute"}`,
                {
                    parse_mode: "Markdown"
                }
            );

        } catch (err) {

            console.error(err);

            ctx.reply("❌ Failed to mute member.");

        }

    });
